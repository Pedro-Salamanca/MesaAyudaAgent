# =====================================================================
# PLANTILLA DE CONFIGURACIÓN - AGENTE MESA DE AYUDA (SOMOS NETWORK)
# =====================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo exactamente como '.env'
# 2. Reemplaza los valores con tus credenciales y rutas locales.
# 3. NUNCA subas el archivo '.env' real a GitHub.
# =====================================================================

# Clave de API de Google Gemini (Generada en Google AI Studio)
GEMINI_API_KEY=tu_clave_api_gemini_aqui

# Claves de API de respaldo opcionales (separadas por coma para failover en cuotas 429)
GEMINI_BACKUP_KEYS=clave_respaldo_1_opcional,clave_respaldo_2_opcional

# Nombre o alias del operador de Mesa de Ayuda
TECNICO_NOMBRE=Operador_Mesa

# Ruta de almacenamiento local o compartida (Google Drive) para la base de datos
MEMORY_PATH=G:\Mi unidad\MesaAyuda_Memoria
